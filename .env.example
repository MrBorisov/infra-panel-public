# Только для Docker: домен для Caddy и его HTTPS-сертификата (DNS A-запись — на сервер)
DOMAIN=panel.example.com
# Полный адрес панели: ссылки в оповещениях и приглашениях
PUBLIC_URL=https://panel.example.com

# Ключ шифрования паролей и токенов (32 байта в base64). Сгенерировать:
#   openssl rand -base64 32
# ВАЖНО: без этого ключа сохранённые пароли не расшифровать.
# Сохраните его копию в Passwork, отдельно от бэкапов базы.
ENCRYPTION_KEY=

APP_NAME=Infra Panel

# ── Оповещения ──
# Telegram и Discord шлют боты на зарубежной VDS (из РФ их API недоступны), см. bots/README.md.
# Секреты моста: openssl rand -hex 32 (у ботов на VDS — те же значения)
BOT_API_TOKEN=
TG_BOT_API_TOKEN=
# Username Telegram-бота панели (отдельный бот, только для панели) — для ссылки привязки
TELEGRAM_BOT_USERNAME=
# IP VDS с ботами через запятую: мост /api/v1/* принимает запросы только с них. Пусто — с любых адресов
BOT_ALLOWED_IPS=

# Мониторинг
CHECK_INTERVAL_SEC=60
FAIL_THRESHOLD=2
CHECKS_RETENTION_DAYS=30

# Время жизни сессии, часов
SESSION_TTL_HOURS=168
