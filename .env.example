# Docker only: the domain for Caddy and its HTTPS certificate (DNS A record → this server)
DOMAIN=panel.example.com
# Full panel address: used in links in alerts and invites
PUBLIC_URL=https://panel.example.com

# Key for encrypting passwords and tokens (32 bytes, base64). Generate with:
#   openssl rand -base64 32
# IMPORTANT: without this key the stored passwords cannot be decrypted.
# Keep a copy somewhere safe, separately from the database backups.
ENCRYPTION_KEY=

APP_NAME=Infra Panel

# ── Alerts ──
# Telegram and Discord messages are sent by relay bots on a VDS, see bots/README.md.
# Bridge secrets: openssl rand -hex 32 (the bots on the VDS use the same values)
BOT_API_TOKEN=
TG_BOT_API_TOKEN=
# Username of the panel's Telegram bot (a separate bot, used only by the panel) — for the link button
TELEGRAM_BOT_USERNAME=
# Comma-separated IPs of the bot VDS: the /api/v1/* bridge accepts requests only from them. Empty — from anywhere
BOT_ALLOWED_IPS=

# Monitoring
CHECK_INTERVAL_SEC=60
FAIL_THRESHOLD=2
CHECKS_RETENTION_DAYS=30

# Session lifetime, hours
SESSION_TTL_HOURS=168
