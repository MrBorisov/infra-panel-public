{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "drizzle.config.ts"],
  // Тесты модулей, как и tests/, гоняет node --test через tsx, а не tsc
  "exclude": ["src/modules/*/tests"]
}
