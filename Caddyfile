# Caddy сам получит и будет продлевать сертификат Let's Encrypt для домена из DOMAIN
{$DOMAIN} {
	encode zstd gzip

	# Дополнительная защита: пускать только с доверенных IP (офис, VPN).
	# Раскомментируйте и впишите свои адреса.
	# @denied not remote_ip 203.0.113.0/24 198.51.100.7
	# respond @denied 403

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
